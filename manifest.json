{
  "manifest_version": 2,
  "name": "Hello Popup Button",
  "version": "1.0.0",
  "description": "Adds a toolbar button that shows a hello popup.",
  "browser_action": {
    "default_title": "Hello Popup"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["windows", "activeTab"]
}
